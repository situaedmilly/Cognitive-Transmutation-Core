{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ourself.local/schemas/aethernet-transition-contract-v0.1.json",
  "title":"AETHERNET Transition Contract v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","reality_id","primitive","transition_id","source","network_ingress","preimage","candidate","identity","authority","jurisdiction","capability","admission","execution","receipt","next_instance","descriptors"],
  "properties":{
    "schema":{"const":"AETHERNET-TRANSITION-CONTRACT-v0.1"},
    "reality_id":{"const":"ALCHEMYSELFTELLIGENCE"},
    "primitive":{"const":"AETHERRECEIVER"},
    "transition_id":{"type":["string","null"]},
    "source":{"type":"object"},
    "network_ingress":{"type":"object"},
    "preimage":{"type":"object"},
    "candidate":{"type":"object"},
    "identity":{"type":"object"},
    "authority":{"type":"object"},
    "jurisdiction":{"type":"object"},
    "capability":{"type":"object"},
    "admission":{"type":"object"},
    "execution":{"type":"object"},
    "receipt":{"type":"object"},
    "next_instance":{"type":"object"},
    "descriptors":{
      "type":"object",
      "required":["aether_in","aether_out"],
      "properties":{
        "aether_in":{
          "type":"object",
          "required":["layer","writable_by","foreign_write_authority"],
          "properties":{
            "layer":{"const":"MEMBRANE"},
            "writable_by":{"const":"AETHERRECEIVER"},
            "foreign_write_authority":{"const":false}
          }
        },
        "aether_out":{
          "type":"object",
          "required":["layer","writable_by","foreign_write_authority","closed_to_foreign_input"],
          "properties":{
            "layer":{"const":"ADMITTED_ACTUATION"},
            "writable_by":{"const":"MEMBRANE_ONLY"},
            "foreign_write_authority":{"const":false},
            "closed_to_foreign_input":{"const":true}
          }
        }
      }
    }
  }
}
